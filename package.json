{
  "name": "tosijs-styled-editor",
  "version": "0.4.5",
  "description": "Rich text editor web component \u2014 no contentEditable, no browser selection APIs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonioloewald/tosijs-editor.git"
  },
  "homepage": "https://editor.tosijs.net",
  "bugs": {
    "url": "https://github.com/tonioloewald/tosijs-editor/issues"
  },
  "source": "src/index.ts",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "./dist/module.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/module.js",
      "browser": "./dist/index.js",
      "default": "./dist/module.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "bun bin/site.ts",
    "make": "bun bin/site.ts --build",
    "prepublishOnly": "bun run make && bun test && bun run lint",
    "test": "bun test",
    "lint": "bun run typecheck",
    "format": "bun prettier --write .",
    "haltija": "haltija --name tosijs-editor --port 8702 --server",
    "tls": "bunx tosijs-dev-certs",
    "typecheck": "bun tsc --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "author": "Tonio Loewald",
  "license": "Apache-2.0",
  "peerDependencies": {
    "tosijs": "^1.10.1",
    "tosijs-ui": "^1.13.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.0",
    "chokidar": "^4.0.3",
    "haltija": "1.12.9",
    "happy-dom": "^20.14.0",
    "prettier": "^2",
    "tjs-lang": "^0.13.1",
    "tosijs": "^1.10.1",
    "tosijs-ui": "^1.13.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "dependencies": {
    "tosijs-kilpi": "^1.0.0"
  }
}
