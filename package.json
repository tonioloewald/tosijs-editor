{
  "name": "tosijs-styled-editor",
  "version": "0.2.0",
  "description": "Rich text editor web component — no contentEditable, no browser selection APIs",
  "source": "src/index.ts",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "./dist/module.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/module.js",
      "browser": "./dist/index.js",
      "default": "./dist/module.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun bin/site.ts",
    "make": "bun bin/site.ts --build",
    "test": "bun test",
    "haltija": "haltija --name tosijs-editor --port 8702 --server",
    "tls": "bunx tosijs-dev-certs",
    "format": "bun eslint src demo --fix && bun prettier --write ."
  },
  "author": "Tonio Loewald",
  "license": "Apache-2.0",
  "peerDependencies": {
    "tosijs": "^1.10.1",
    "tosijs-ui": "^1.13.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.0",
    "chokidar": "^4.0.3",
    "haltija": "1.12.9",
    "happy-dom": "^20.14.0",
    "tjs-lang": "^0.13.1",
    "tosijs": "^1.10.1",
    "tosijs-ui": "^1.13.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}
