{
  "name": "tosijs-styled-editor",
  "version": "0.2.0",
  "description": "Rich text editor web component — no contentEditable, no browser selection APIs",
  "source": "src/index.ts",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "./dist/module.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/module.js",
      "browser": "./dist/index.js",
      "default": "./dist/module.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun --watch dev.ts",
    "format": "bun eslint src demo --fix && bun prettier --write .",
    "test": "bun test",
    "build": "bun dev.ts --build"
  },
  "author": "Tonio Loewald",
  "license": "Apache-2.0",
  "peerDependencies": {
    "tosijs": "^1.4.0",
    "tosijs-ui": "^1.4.0"
  },
  "devDependencies": {
    "tosijs": "^1.4.0",
    "tosijs-ui": "^1.4.0",
    "bun-types": "^1.3.0",
    "chokidar": "^4.0.3",
    "happy-dom": "^20.7.0",
    "typescript": "^5.9.3"
  }
}
